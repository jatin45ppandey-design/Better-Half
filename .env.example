# PlaySpace Frontend Environment (React + Vite)
# Copy this file to .env.local and fill in your values.
# Only VITE_ variables are exposed to the browser. Never put backend secrets or database credentials here.

VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Application URLs
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000

