# PlaySpace frontend environment (React + Vite)
# Copy this file to .env.local and fill in your own values.
# Only VITE_ variables are exposed to browser code. Never put secrets here.

VITE_NEON_AUTH_URL=PASTE_NEON_AUTH_BASE_URL
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000
