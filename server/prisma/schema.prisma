datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// PlaySpace Phase 1 Models: Profiles, Settings, Social Graph
// -------------------------------------------------------------

model UserProfile {
  id             String         @id // Matches Supabase Auth user UUID
  username       String         @unique
  displayName    String
  avatarUrl      String?
  avatarInitials String?
  avatarColor    String?        @default("#9670E8")
  bio            String?        @default("")
  accountStatus  String         @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  settings       UserSettings?

  // Social relationships
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendships            Friendship[]    @relation("UserFriendships")
  friendshipsAsFriend    Friendship[]    @relation("FriendFriendships")
  blocksInitiated        BlockedUser[]   @relation("BlockerUsers")
  blocksReceived         BlockedUser[]   @relation("BlockedUsers")

  // Phase 2 Room & Multiplayer relationships
  hostedRooms            Room[]          @relation("HostedRooms")
  roomParticipations     RoomParticipant[] @relation("RoomParticipations")
  sentRoomInvitations    RoomInvitation[] @relation("SentRoomInvitations")
  receivedRoomInvitations RoomInvitation[] @relation("ReceivedRoomInvitations")
  roomMessages           RoomMessage[]   @relation("RoomMessages")
  gameVotes              GameVote[]      @relation("GameVotes")
  gameSessionParticipations GameSessionParticipant[] @relation("GameSessionParticipations")

  // Phase 4 Match History, Stats, Rivalry & Moderation
  matchParticipations    MatchParticipant[] @relation("UserMatchParticipations")
  matchesWon             Match[]            @relation("WonMatches")
  gameStats              UserGameStats[]    @relation("UserGameStats")
  rivalriesAsLow         RivalryStats[]     @relation("RivalryUserLow")
  rivalriesAsHigh        RivalryStats[]     @relation("RivalryUserHigh")
  roles                  AppRole[]          @relation("UserRoles")
  moderations            UserModeration[]   @relation("UserModerations")
  moderationsGiven       UserModeration[]   @relation("ModeratedBy")

  @@index([username])
  @@index([displayName])
}

model UserSettings {
  id                 String      @id @default(uuid())
  userId             String      @unique
  showOnlineStatus   Boolean     @default(true)
  allowDirectInvites Boolean     @default(true)
  publicMatchHistory Boolean     @default(true)
  ghostMode          Boolean     @default(false)
  soundMuted         Boolean     @default(false)
  volume             Float       @default(0.8)
  reducedMotion      Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id         String      @id @default(uuid())
  senderId   String
  receiverId String
  status     String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  sender   UserProfile @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver UserProfile @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model Friendship {
  id        String      @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime    @default(now())

  user   UserProfile @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend UserProfile @relation("FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model BlockedUser {
  id            String      @id @default(uuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime    @default(now())

  blocker     UserProfile @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser UserProfile @relation("BlockedUsers", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
  @@index([blockedUserId])
}

// -------------------------------------------------------------
// PlaySpace Phase 2 Models: Rooms, Lobby, Invitations, Chat
// -------------------------------------------------------------

model Room {
  id             String            @id @default(uuid())
  code           String            @unique // 6-character room code (e.g. LOVE22, PLAY69)
  hostId         String
  name           String
  mode           String            // "COUPLE" | "FRIEND"
  status         String            @default("WAITING") // WAITING, READY_TO_START, IN_PROGRESS, COMPLETED, CLOSED, EXPIRED
  selectedGameId String?
  maxPlayers     Int               @default(2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  expiresAt      DateTime

  host           UserProfile       @relation("HostedRooms", fields: [hostId], references: [id], onDelete: Cascade)
  participants   RoomParticipant[]
  invitations    RoomInvitation[]
  messages       RoomMessage[]
  gameVotes      GameVote[]
  gameSessions   GameSession[]

  @@index([code])
  @@index([hostId])
  @@index([status])
  @@index([expiresAt])
}

model RoomParticipant {
  id        String      @id @default(uuid())
  roomId    String
  userId    String
  role      String      @default("PLAYER") // HOST, PLAYER
  isReady   Boolean     @default(false)
  joinedAt  DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  leftAt    DateTime?
  kickedAt  DateTime?

  room Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user UserProfile @relation("RoomParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([role])
}

model RoomInvitation {
  id         String      @id @default(uuid())
  roomId     String
  senderId   String
  receiverId String
  status     String      @default("PENDING") // PENDING, ACCEPTED, DECLINED, CANCELLED, EXPIRED
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  expiresAt  DateTime

  room     Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender   UserProfile @relation("SentRoomInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver UserProfile @relation("ReceivedRoomInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([roomId, receiverId])
  @@index([roomId])
  @@index([receiverId])
  @@index([status])
}

model RoomMessage {
  id        String      @id @default(uuid())
  roomId    String
  senderId  String
  message   String
  createdAt DateTime    @default(now())

  room   Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender UserProfile @relation("RoomMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([senderId])
}

model GameVote {
  id        String      @id @default(uuid())
  roomId    String
  userId    String
  gameId    String
  createdAt DateTime    @default(now())

  room Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user UserProfile @relation("GameVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([gameId])
}

// -------------------------------------------------------------
// PlaySpace Phase 3 Models: Game Sessions, Participants, Actions
// -------------------------------------------------------------

model GameSession {
  id                String                   @id @default(uuid())
  roomId            String
  gameId            String
  mode              String                   // "COUPLE" | "FRIEND"
  status            String                   @default("ACTIVE") // STARTING, ACTIVE, PAUSED, COMPLETED, ABANDONED
  startedAt         DateTime                 @default(now())
  completedAt       DateTime?
  currentRound      Int                      @default(1)
  currentTurnUserId String?
  stateVersion      Int                      @default(1)
  publicState       Json
  rngSeed           String?
  deadlineAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  room              Room                     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants      GameSessionParticipant[]
  actions           GameAction[]
  match             Match?

  @@index([roomId])
  @@index([gameId])
  @@index([status])
}

model GameSessionParticipant {
  id           String      @id @default(uuid())
  sessionId    String
  userId       String
  seatIndex    Int
  status       String      @default("ACTIVE") // ACTIVE, DISCONNECTED, SPECTATING
  score        Int         @default(0)
  isActive     Boolean     @default(true)
  privateState Json?       // E.g. UNO hand, never exposed publicly
  joinedAt     DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  session      GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         UserProfile @relation("GameSessionParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model GameAction {
  id                String      @id @default(uuid())
  sessionId         String
  actorUserId       String
  actionId          String
  sequenceNumber    Int
  actionType        String
  sanitizedMetadata Json?
  createdAt         DateTime    @default(now())

  session           GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, actionId])
  @@index([sessionId, sequenceNumber])
}

// -------------------------------------------------------------
// PlaySpace Phase 4 Models: Match History, Stats, Rivalry & Admin
// -------------------------------------------------------------

model Match {
  id              String             @id @default(uuid())
  gameSessionId   String             @unique
  roomId          String
  gameId          String
  mode            String             // "COUPLE" | "FRIEND"
  resultType      String             // "COMPETITIVE" | "COOPERATIVE" | "DRAW" | "ABANDONED"
  winnerUserId    String?
  startedAt       DateTime
  completedAt     DateTime           @default(now())
  durationSeconds Int                @default(0)
  roundsPlayed    Int                @default(1)
  resultSummary   Json?
  createdAt       DateTime           @default(now())

  gameSession     GameSession        @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  winner          UserProfile?       @relation("WonMatches", fields: [winnerUserId], references: [id], onDelete: SetNull)
  participants    MatchParticipant[]

  @@index([gameId])
  @@index([mode])
  @@index([completedAt])
  @@index([winnerUserId])
  @@index([roomId])
}

model MatchParticipant {
  id                 String      @id @default(uuid())
  matchId            String
  userId             String
  playerNameSnapshot String
  usernameSnapshot   String
  avatarUrlSnapshot  String?
  scoreValue         Float?
  scoreLabel         String?
  placement          Int?
  outcome            String      // "WIN" | "LOSS" | "DRAW" | "COMPLETED" | "ABANDONED"
  isWinner           Boolean     @default(false)
  createdAt          DateTime    @default(now())

  match              Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user               UserProfile @relation("UserMatchParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, createdAt])
  @@index([matchId])
  @@index([outcome])
}

model UserGameStats {
  id                     String      @id @default(uuid())
  userId                 String
  gameId                 String
  matchesPlayed          Int         @default(0)
  wins                   Int         @default(0)
  losses                 Int         @default(0)
  draws                  Int         @default(0)
  cooperativeCompletions Int         @default(0)
  lastPlayedAt           DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user                   UserProfile @relation("UserGameStats", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

model RivalryStats {
  id                     String      @id @default(uuid())
  userLowId              String
  userHighId             String
  matchesPlayed          Int         @default(0)
  competitiveMatches     Int         @default(0)
  userLowWins            Int         @default(0)
  userHighWins           Int         @default(0)
  draws                  Int         @default(0)
  cooperativeCompletions Int         @default(0)
  currentStreakHolder    String?
  currentStreakCount     Int         @default(0)
  lastMatchAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  userLow                UserProfile @relation("RivalryUserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh               UserProfile @relation("RivalryUserHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  @@index([matchesPlayed])
}

model AppRole {
  id          String      @id @default(uuid())
  userId      String
  role        String      // "ADMIN" | "MODERATOR"
  assignedBy  String?
  createdAt   DateTime    @default(now())

  user        UserProfile @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model UserModeration {
  id          String       @id @default(uuid())
  userId      String
  status      String       // "ACTIVE" | "SUSPENDED"
  reason      String?
  moderatorId String?
  createdAt   DateTime     @default(now())

  user        UserProfile  @relation("UserModerations", fields: [userId], references: [id], onDelete: Cascade)
  moderator   UserProfile? @relation("ModeratedBy", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model GameConfiguration {
  id                 String   @id @default(uuid())
  gameId             String   @unique
  isEnabled          Boolean  @default(true)
  coupleEnabled      Boolean  @default(true)
  friendEnabled      Boolean  @default(true)
  maintenanceMessage String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isEnabled])
}

model QuestionEntry {
  id           String   @id @default(uuid())
  gameId       String
  sourceKey    String   @unique
  prompt       String
  questionType String?  // "TRUTH" | "DARE" | null
  optionA      String?
  optionB      String?
  category     String?
  intensity    Int?
  isActive     Boolean  @default(true)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([gameId, isActive])
  @@index([category])
  @@index([intensity])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String   // e.g. "USER_SUSPENDED", "ROLE_GRANTED", "GAME_CONFIG_UPDATED"
  targetType  String   // "USER", "GAME", "QUESTION", "SYSTEM"
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}


