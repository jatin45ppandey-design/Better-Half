# PlaySpace backend environment (Node.js + Socket.IO)
# Copy this file to server/.env and fill in your own values.
# Never commit server/.env.

NODE_ENV=development
PORT=4000

# Frontend origin allowed by backend CORS
FRONTEND_ORIGIN=http://localhost:5173

# Neon PostgreSQL
# Use the pooled connection string for runtime queries.
DATABASE_URL=PASTE_NEON_POOLED_CONNECTION_STRING
# Use the direct connection string for migrations when required by the ORM.
DIRECT_URL=PASTE_NEON_DIRECT_CONNECTION_STRING

# Neon Managed Auth
NEON_AUTH_BASE_URL=PASTE_NEON_AUTH_BASE_URL
NEON_AUTH_JWKS_URL=PASTE_NEON_AUTH_JWKS_URL
